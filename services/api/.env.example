DATABASE_URL=postgres://aurelia:change-me@localhost:5432/aurelia
RUST_LOG=info,tower_http=info
# Comma-separated exact browser origins; leave empty to disable cross-origin access.
CORS_ALLOWED_ORIGINS=
# Staff session cookies are Secure by default. Set false only for local plain-HTTP testing.
COOKIE_SECURE=true
# Exact browser origins allowed to submit staff login/logout requests.
CSRF_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088
